# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO
# text | json | auto (auto = text em dev, json fora)
LOG_FORMAT=auto

# ---- Banco / fila ----
# localhost = API/worker no host com db/redis do compose.
# Em docker compose, api/worker sobrescrevem para @db / @redis.
DATABASE_URL=postgresql+psycopg://stories:stories@localhost:5432/stories
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
JWT_SECRET=troque-por-um-segredo-forte
ACCESS_TOKEN_TTL_MIN=1440
# Minutos apos o TTL em que /v1/auth/resume ainda reemite o mesmo user (orfaos).
GUEST_RESUME_GRACE_MIN=43200
# Vazio = POST /v1/credits/grant recusa. Nao use no frontend.
CREDIT_GRANT_SECRET=

# ---- Storage (R2/S3) ----
STORAGE_BUCKET=stories-prod
STORAGE_ENDPOINT_URL=            # ex.: https://<account>.r2.cloudflarestorage.com (vazio = AWS S3)
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SIGNING_TTL=600

# ---- Politica ----
MAX_CONCURRENT_JOBS_PER_USER=4
DEFAULT_VIDEO_DURATION_S=5
SIGNUP_BONUS_CREDITS=10
OFFLINE_FALLBACK=true

# ---- Painel de gastos (/gastos) ----
USAGE_DASHBOARD_PASSWORD=
# Senha anterior aceita durante rotacao (opcional).
USAGE_DASHBOARD_PASSWORD_PREVIOUS=
# Lockout apos N falhas por IP (0 = desliga). Janela em segundos.
USAGE_LOCKOUT_MAX_ATTEMPTS=5
USAGE_LOCKOUT_WINDOW_S=900
# PRICE_GEMINI_IMAGE_USD=0.039
# PRICE_OPENAI_IMAGE_USD=0.04
# PRICE_CLAUDE_INPUT_PER_MTOK=15
# PRICE_CLAUDE_OUTPUT_PER_MTOK=75
# PRICE_KLING_PER_SECOND_USD=0.10

# ---- Webhooks ----
WEBHOOK_SIGNING_SECRET=troque-por-um-segredo-webhook

# ---- Provedores de IA ----
GEMINI_API_KEY=        # Nano Banana Pro (Gemini 3 Pro Image)
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_MODEL_FALLBACK=  # vazio = so Pro; sem queda para Flash no 503
GEMINI_IMAGE_SIZE=2K   # 1K | 2K | 4K; deixe VAZIO se voltar a gemini-2.5-flash-image
GEMINI_TIMEOUT_S=240   # Pro pensa antes de gerar; 120s dava ReadTimeout
GEMINI_SSL_VERIFY=system  # system = loja de certificados do SO (antivirus/proxy que reassina TLS)
# Localiza o rosto da crianca para o recorte de identidade (modelo de texto, ~1200
# tokens por foto). VAZIO desliga e usa o recorte geometrico offline.
GEMINI_FACE_MODEL=gemini-3.1-flash-lite
GEMINI_FACE_RETRIES=3
OPENAI_API_KEY=        # GPT Image (avatar, cena, ebook) — obrigatorio se IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE_PORTRAIT=1024x1536
# OPENAI_IMAGE_SIZE_SQUARE=1024x1024
ANTHROPIC_API_KEY=     # historia (Claude)
KLING_ACCESS_KEY=      # video image2video (unico provedor de video)
KLING_SECRET_KEY=
ELEVENLABS_API_KEY=    # TTS video narrado (opcional; sem chave usa edge-tts)
ELEVENLABS_VOICE_ID=
# Fal.ai: avatar (flux-pulid) + passe de cabeca (face-swap) + SAM no recorte.
FAL_KEY=
IDENTITY_HEAD_PROVIDER=pulid   # pulid | gemini
FACE_MATCH_BACKEND=insightface # insightface | gemini
FACE_SEGMENT=true
# FAL_SAM_ENDPOINT=fal-ai/sam2/image
# FAL_SAM_TIMEOUT_S=45

IMAGE_PROVIDER=openai
TEXT_PROVIDER=claude
VIDEO_PROVIDER=kling           # unico suportado; outros nomes falham na factory

# Refine de cena (storyboard/ebook). Com GPT Image o refine e no-op no provider.
EBOOK_PAGES=6
EBOOK_CHARACTER_BIBLE=false
EBOOK_REFINE_SCENE=false
EBOOK_PAGE_CONCURRENCY=3
EBOOK_FACE_MATCH=false
EBOOK_FACE_MATCH_MIN=0.72
EBOOK_AVATAR_MATCH_MIN=0.75
EBOOK_EYE_INFLATE_MAX=0.15

# Comet Opik (tracing + avaliacao). Sem chave/URL o wrapper e no-op.
OPIK_API_KEY=
OPIK_WORKSPACE=storyrus
OPIK_PROJECT_NAME=storyrus
# Self-host (opcional; vazio = Cloud):
# OPIK_URL_OVERRIDE=http://localhost:5173/api
OPIK_EVAL_STORY=true
